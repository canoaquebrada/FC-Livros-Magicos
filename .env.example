# Copie este arquivo para .env e preencha. `npm run dev` lê .env automaticamente.
# No Cloudflare Workers use as mesmas chaves como secrets/bindings do Worker.

# ---- Obrigatório para receber os pedidos no WhatsApp ----
# Número da loja no WhatsApp: DDI + DDD + número, só dígitos. Ex.: 5511999999999
WHATSAPP_NUMBER=
# Nome da loja que aparece no pedido e no resumo.
SHOP_NAME=FC Livros Mágicos
# Valor cobrado (mostrado no site e na página do pedido) e chave Pix para cobrar.
PRICE_LABEL=R$ 49,90
PIX_KEY=
# Frase sorte que assina o link privado do pedido (qualquer texto longo).
# No Cloudflare configure como secret para assinar os links.
ORDER_SECRET=
# Token do painel de pedidos: abra /painel?token=<ADMIN_TOKEN>
ADMIN_TOKEN=

# ---- Opcional: enviar o pedido sozinho (WhatsApp Cloud API da Meta) ----
# WHATSAPP_TOKEN=
# WHATSAPP_PHONE_ID=

# ---- Opcional: geração da história (sem chave usa o provedor de demonstração) ----
# AI_PROVIDER=mock            # mock | openai | gemini | anthropic
# AI_API_KEY=
# AI_MODEL=
